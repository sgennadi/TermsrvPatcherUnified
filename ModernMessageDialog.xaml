<Window x:Class="TermsrvPatcherUnified.ModernMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Width="660" Height="365" MinWidth="500" MinHeight="290"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize" FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource BackgroundBrush}" Icon="Assets/app.ico">
  <Grid Margin="22,18,22,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,13">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="MessageIconBorder" Width="38" Height="38" CornerRadius="12"
              Background="#EAF3FF" VerticalAlignment="Top">
        <TextBlock x:Name="MessageIcon" Text="i" FontSize="22" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#2356A0"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="8,0,0,0">
        <TextBlock x:Name="HeadingText" Text="Please review" TextWrapping="Wrap"
                   FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
        <TextBlock x:Name="SubtitleText" Text="No changes occur unless you approve."
                   TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                   Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1"
            BorderThickness="1" CornerRadius="10" Padding="15"
            Margin="0,0,0,13">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="BodyText" TextWrapping="Wrap" Foreground="#334155"
                   FontSize="13" LineHeight="21"/>
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="HintText" TextWrapping="Wrap" VerticalAlignment="Center"
                 Foreground="{StaticResource MutedBrush}" FontSize="12"
                 Margin="0,0,10,0" Text="Esc closes this window without approval."/>
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="Cancel" MinWidth="100"
                IsCancel="True" Visibility="Collapsed" Click="Cancel_Click"
                Margin="0,0,8,0"/>
        <Button x:Name="NoButton" Content="No" MinWidth="100"
                IsCancel="True" Visibility="Collapsed" Click="No_Click"
                Margin="0,0,8,0"/>
        <Button x:Name="AcceptButton" Content="OK" MinWidth="140"
                Style="{StaticResource PrimaryButton}" IsDefault="False"
                Click="Accept_Click" Margin="0"/>
      </WrapPanel>
    </Grid>
  </Grid>
</Window>

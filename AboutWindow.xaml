<Window x:Class="TermsrvPatcherUnified.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About / Components — 1.0.4" Height="435" Width="590" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="13" Background="{StaticResource BackgroundBrush}" Icon="Assets/app.ico">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="TermsrvPatcherUnified" FontWeight="SemiBold" FontSize="22"/>
      <TextBlock Text="Component information and license notices" Foreground="#50657B" Margin="0,5,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Background="White" BorderBrush="#CAD8E9" BorderThickness="1" CornerRadius="7" Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Application" FontWeight="SemiBold"/>
          <TextBlock x:Name="AppVersionText" Margin="0,3,0,12" TextWrapping="Wrap"/>
          <TextBlock Text="Protected file access" FontWeight="SemiBold"/>
          <TextBlock x:Name="NSudoStatusText" Margin="0,3,0,12" TextWrapping="Wrap"/>
          <TextBlock Text="Updates" FontWeight="SemiBold"/>
          <TextBlock Text="UniversalUpdater — verified release checks and in-place updates from local folders, including Desktop." Margin="0,3,0,12" TextWrapping="Wrap"/>
          <TextBlock Text="Diagnostics" FontWeight="SemiBold"/>
          <TextBlock Text="UniversalDiagnostics — local capture and optional reviewed GitHub Issue publication; no background upload." Margin="0,3,0,12" TextWrapping="Wrap"/>
          <TextBlock Text="Licensing" FontWeight="SemiBold"/>
          <TextBlock Text="GPLv3 application, MIT licensed NSudo and adapted fabianosrc contributions. See LICENSE and NOTICE." Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Button Grid.Row="2" Tag="&#xE8BB;" Content="Close" MinWidth="100" HorizontalAlignment="Right" Margin="0,14,0,0" Padding="14,7" Click="Close_Click"/>
  </Grid>
</Window>

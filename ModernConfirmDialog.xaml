<Window x:Class="TermsrvPatcherUnified.ModernConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review and confirm — 1.0.5" Width="900" Height="660"
        MinWidth="610" MinHeight="480" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource BackgroundBrush}" Icon="Assets/app.ico">
  <Grid Margin="24,18,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock x:Name="HeadingText" FontWeight="SemiBold" FontSize="23"
                 Foreground="{StaticResource NavyBrush}" TextWrapping="Wrap"
                 Text="Review your request"/>
      <TextBlock x:Name="DescriptionText" Margin="0,8,0,0"
                 TextWrapping="Wrap" Foreground="#475569"
                 Text="Review the details below. Nothing happens until you confirm."/>
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="#C6D9F2" BorderThickness="1"
            CornerRadius="10" Background="#EAF3FF" Padding="13"
            Margin="0,0,0,12">
      <StackPanel>
        <TextBlock x:Name="DestinationTitle" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource NavyBrush}" Text="Destination"/>
        <TextBlock x:Name="DestinationText" TextWrapping="Wrap" Margin="0,5,0,0"
                   Foreground="#334155" FontSize="12"/>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="2" x:Name="DetailsHeading" Text="Exact information to share"
               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
               Foreground="{StaticResource NavyBrush}"/>
    <Border Grid.Row="3" Background="White" BorderBrush="#CBD5E1"
            CornerRadius="10" BorderThickness="1" Padding="3"
            Margin="0,0,0,12">
      <TextBox x:Name="DetailsText" IsReadOnly="True"
               FontFamily="Consolas" FontSize="12"
               TextWrapping="Wrap" AcceptsReturn="True"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               Padding="12" BorderThickness="0" Background="White"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Border>
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock x:Name="PrivacyText" Text="You stay in control. You can cancel without making changes."
                   TextWrapping="Wrap" Foreground="#64748B" FontSize="12"
                   Margin="0,0,12,0"/>
      </StackPanel>
      <Button Grid.Column="1" x:Name="CopyButton" Content="Copy details"
              Click="Copy_Click" MinWidth="110" Margin="0,0,8,0"/>
      <Button Grid.Column="2" x:Name="CancelButton" Content="Not now"
              IsCancel="True" Click="Cancel_Click" MinWidth="100" Margin="0,0,8,0"/>
      <Button Grid.Column="3" x:Name="ConfirmButton" Content="Confirm"
              Style="{StaticResource PrimaryButton}" Click="Confirm_Click"
              MinWidth="145" Margin="0"/>
    </Grid>
  </Grid>
</Window>

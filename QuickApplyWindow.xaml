<Window x:Class="TermsrvPatcherUnified.QuickApplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TermsrvPatcherUnified 0.1.0-preview.22"
        Width="705" Height="420" MinWidth="640" MinHeight="396"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13" Icon="Assets/app.ico">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="TermsrvPatcherUnified" FontSize="23" FontWeight="SemiBold"
                 Foreground="{StaticResource NavyBrush}"/>
      <TextBlock Text="0.1.0-preview.22 · Automatic check" FontSize="12"
                 Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"/>
    </StackPanel>
    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="18">
      <StackPanel>
        <TextBlock x:Name="QuickSystemText" Text="Detecting Windows and checking termsrv.dll..."
                   FontWeight="SemiBold" FontSize="15"/>
        <TextBlock x:Name="QuickDllText" Text="Read-only verification in progress"
                   Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"/>
        <TextBlock x:Name="QuickStatusText" Text="Checking..."
                   Margin="0,13,0,0" FontWeight="SemiBold" FontSize="15"
                   Foreground="{StaticResource NavyBrush}"/>
        <TextBlock x:Name="QuickHelpText"
                   Text="Apply is available only after an exact, verified signature match."
                   TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"/>
        <TextBlock x:Name="QuickLastJobText" Text="" FontSize="12"
                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                   Margin="0,8,0,0"/>
        <TextBlock x:Name="QuickBackupInfoText"
                   Text="Full backup is ON: verified .bak in System32 and protected archived copy."
                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>
    <CheckBox x:Name="QuickNoBackupCheck" Grid.Row="2" Margin="0,12,0,0"
              Content="Do not create backup" IsChecked="False"
              Checked="BackupOptionChanged" Unchecked="BackupOptionChanged"
              ToolTip="Disables full DLL .bak and ProgramData backup. A small encrypted recovery journal is still required for Automatic Apply."/>
    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="QuickApplyButton" Grid.Column="0"
              Content="Apply" Tag="&#xE8FB;" Style="{StaticResource PrimaryButton}"
              IsEnabled="False" Click="Apply_Click" MinWidth="124"
              HorizontalAlignment="Left"/>
      <Button x:Name="QuickRevertButton" Grid.Column="1" Content="Revert"
              Click="Revert_Click" MinWidth="88" IsEnabled="False" Tag="&#xE777;"/>
      <Button x:Name="QuickCheckButton" Grid.Column="2" Content="Check"
              Click="Check_Click" MinWidth="78" Tag="&#xE72C;"/>
      <Button x:Name="QuickAdvancedButton" Grid.Column="3" Content="Advanced"
              Click="Advanced_Click" MinWidth="106" Tag="&#xE713;"/>
      <Button x:Name="QuickCancelButton" Grid.Column="4" Content="Cancel"
              Click="Cancel_Click" MinWidth="88"/>
    </Grid>
  </Grid>
</Window>
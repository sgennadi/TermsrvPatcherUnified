<Window x:Class="TermsrvPatcherUnified.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cleanup — 1.0.7-preview.1"
        Width="640" Height="545" MinWidth="540" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13" Icon="Assets/app.ico">
  <Grid Margin="23">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Cleanup" FontSize="23" FontWeight="SemiBold"
                 Foreground="{StaticResource NavyBrush}"/>
      <TextBlock Text="Remove only TermsrvPatcherUnified data. Select the categories to remove."
                 Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Padding="17">
      <StackPanel>
        <CheckBox x:Name="CleanupBackupsCheck"
                  Content="Backups and recovery journals"
                  FontWeight="SemiBold" Margin="0,0,0,6"
                  Checked="SelectionChanged" Unchecked="SelectionChanged"/>
        <TextBlock Text="Includes System32 termsrv.dll.bak. Removal can permanently disable automatic Revert."
                   Margin="21,0,0,13" Foreground="#8B531A"/>
        <CheckBox x:Name="CleanupReportsCheck"
                  Content="Application logs, history and diagnostic reports"
                  FontWeight="SemiBold" Margin="0,0,0,6"
                  Checked="SelectionChanged" Unchecked="SelectionChanged"/>
        <TextBlock Text="Only the app's own local files; no Windows Event Logs or external exports."
                   Margin="21,0,0,13" Foreground="{StaticResource MutedBrush}"/>
        <CheckBox x:Name="CleanupTaskCheck"
                  Content="Also remove the Auto Reapply scheduled task"
                  FontWeight="SemiBold" Margin="0,0,0,6"
                  Checked="SelectionChanged" Unchecked="SelectionChanged"/>
        <TextBlock x:Name="CleanupTaskStatus"
                   Text="Task status is checked when this window opens."
                   Margin="21,0,0,13" Foreground="{StaticResource MutedBrush}"/>
        <Border Background="#FFF7ED" CornerRadius="8" Padding="12">
          <TextBlock x:Name="CleanupPreview"
                     Text="Choose what to clean. Auto Reapply stays enabled unless selected."
                     TextWrapping="Wrap" Foreground="#8B531A"/>
        </Border>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2" Margin="0,15,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="CleanupExecuteButton" Grid.Column="1"
              Content="Review and clean" Tag="&#xE74D;"
              Style="{StaticResource PrimaryButton}"
              MinWidth="145" IsEnabled="False" Click="Execute_Click"/>
      <Button Grid.Column="2" Content="Close" MinWidth="95"
              Click="Close_Click" Margin="0,0,0,10"/>
    </Grid>
  </Grid>
</Window>
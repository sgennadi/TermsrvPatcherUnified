<Window x:Class="TermsrvPatcherUnified.SuccessfulFixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Successful operation — 0.1.0-preview.27"
        Width="760" Height="540" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI"
        FontSize="13" Icon="Assets/app.ico">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22">
      <TextBlock x:Name="ReportHeading" Text="Patch completed successfully"
                 FontSize="21" FontWeight="SemiBold" Margin="0,0,0,11"
                 Foreground="#0B874C"/>
      <TextBlock x:Name="ReportExplanation" TextWrapping="Wrap"
                 Foreground="#475569" Margin="0,0,0,14"
                 Text="Would you like to share a short compatibility report?
It can help us support this Windows build. You will review the information before sending. No GitHub account or local save is needed."/>
      <Border x:Name="SimpleReportBox" Background="White" BorderBrush="#CBD5E1"
              BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Optional compatibility report" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="No report is sent until you review the details and choose Send."
                     TextWrapping="Wrap" Margin="0,4,0,11" Foreground="#64748B"/>
          <Button x:Name="SimpleReportButton" Content="Review and send report"
                  Style="{StaticResource PrimaryButton}" MinWidth="170"
                  HorizontalAlignment="Left" Click="SimpleReport_Click"/>
        </StackPanel>
      </Border>
      <Expander Header="Advanced: detailed GitHub report (optional)" Margin="0,2,0,11">
        <StackPanel Margin="0,9,0,0">
          <TextBlock TextWrapping="Wrap" Foreground="#64748B"
                     Text="Detailed version and byte-range reports are public GitHub Issues. A temporary token with Issues:write is needed; nothing is sent automatically."/>
          <TextBox x:Name="Preview" IsReadOnly="True"
                   FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                   Height="155" VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   Padding="9" Margin="0,8,0,10"/>
          <TextBlock Text="Temporary GitHub token (never stored)" Margin="0,0,0,5"/>
          <PasswordBox x:Name="TokenInput" MinHeight="34"/>
          <Button x:Name="SendButton" Content="Send detailed report to GitHub"
                  Click="Send_Click" HorizontalAlignment="Left"
                  MinWidth="210" Margin="0,9,0,0"/>
        </StackPanel>
      </Expander>
      <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#64748B"
                 Text="Reporting is optional. You can close this window at any time."
                 Margin="0,3,0,11"/>
      <Button x:Name="SkipButton" Content="Not now" Tag="&#xE8BB;"
              Click="Skip_Click" HorizontalAlignment="Right" MinWidth="115"/>
    </StackPanel>
  </ScrollViewer>
</Window>
<Window x:Class="TermsrvPatcherUnified.SuccessfulFixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compatibility report"
        Width="800" Height="540" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI"
        FontSize="13" Icon="Assets/app.ico">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22">
      <TextBlock x:Name="ReportHeading" Text="Patch completed successfully"
                 FontSize="21" FontWeight="SemiBold" Margin="0,0,0,11"
                 Foreground="#0B874C"/>
      <TextBlock x:Name="ReportExplanation" TextWrapping="Wrap"
                 Foreground="#475569" Margin="0,0,0,14"
                 Text="Optionally share an anonymized compatibility observation.
The complete report is shown below. GitHub will publish this information.
No GitHub account or token is required. Nothing is uploaded automatically."/>
      <Border Background="White" BorderBrush="#CBD5E1"
              BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Exact public report preview" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="Windows/DLL versions, SHA-256 and limited changed byte ranges.
No computer name, account or path. Short before/after DLL byte ranges are PUBLIC and UNVERIFIED."
                     TextWrapping="Wrap" Margin="0,4,0,10" Foreground="#64748B"/>
          <TextBox x:Name="Preview" IsReadOnly="True"
                   FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                   Height="230" VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   Padding="9" Margin="0,0,0,12"/>
          <Button x:Name="SendButton" Content="Review and send"
                  Click="Send_Click" Style="{StaticResource PrimaryButton}"
                  HorizontalAlignment="Left" MinWidth="160"/>
        </StackPanel>
      </Border>
      <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#64748B"
                 Text="Sending is optional. No report has been sent."
                 Margin="0,3,0,11"/>
      <Button x:Name="SkipButton" Content="Not now" Tag="&#xE8BB;"
              Click="Skip_Click" HorizontalAlignment="Right" MinWidth="115"/>
    </StackPanel>
  </ScrollViewer>
</Window>
<Window x:Class="TermsrvPatcherUnified.RdpLocalSettingEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local RDP setting — 0.1.0-preview.28"
        Width="900" Height="665" MinWidth="670" MinHeight="490"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource BackgroundBrush}" Icon="Assets/app.ico">
  <Grid Margin="22,18,22,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Local RDP setting" FontSize="23" FontWeight="SemiBold"
                 Foreground="{StaticResource NavyBrush}"/>
      <TextBlock x:Name="SettingTitle" Text="Loading setting..." TextWrapping="Wrap"
                 FontWeight="SemiBold" Margin="0,8,0,4"/>
      <TextBlock x:Name="GuidanceText" TextWrapping="Wrap"
                 Foreground="#64748B"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Padding="14" BorderBrush="#CBD5E1" BorderThickness="1"
                CornerRadius="10" Background="White" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Current local value" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBlock x:Name="CurrentValueText" Text="Checking..." Margin="0,6,0,12"
                       TextWrapping="Wrap" Foreground="#0B2E5A"/>
            <TextBlock Text="New local value (not yet applied)" FontWeight="SemiBold"
                       Foreground="#334155"/>
            <ComboBox x:Name="ValueChoices" Visibility="Collapsed" MinHeight="38"
                      Margin="0,7,0,6" DisplayMemberPath="Label"/>
            <TextBox x:Name="NumericValue" Visibility="Collapsed" MinHeight="38"
                     Margin="0,7,0,6" Padding="8,5" FontFamily="Consolas"/>
            <TextBlock x:Name="NumberHint" Margin="0,3,0,0"
                       Foreground="#64748B" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Padding="14" BorderBrush="#F7CA96" BorderThickness="1"
                CornerRadius="10" Background="#FFF7ED" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock x:Name="PolicyHeading" Text="Group Policy"
                       FontWeight="SemiBold" FontSize="15" Foreground="#91400B"/>
            <TextBlock x:Name="PolicySummaryText" Text="Looking for a controlling policy..."
                       TextWrapping="Wrap" Margin="0,7,0,9" Foreground="#7C2D12"/>
            <TextBox x:Name="PolicyDetailsText" IsReadOnly="True"
                     Height="116" FontFamily="Consolas" FontSize="12"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Padding="9" Background="White" BorderBrush="#FED7AA"/>
            <Button x:Name="CopyPolicyButton" Content="Copy policy details"
                    Click="CopyPolicy_Click" HorizontalAlignment="Left"
                    Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="ImpactText" TextWrapping="Wrap"
                   Foreground="#64748B" Margin="0,0,0,12"
                   Text="No automatic gpupdate, RDP service restart or reboot will be performed."/>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,13,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Checking local and domain policy..."
                 Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center"
                 Foreground="#64748B" Margin="0,0,15,0"/>
      <Button Grid.Column="1" Content="Reload" Click="Reload_Click"
              MinWidth="90" Margin="0,0,8,0"/>
      <Button Grid.Column="2" Content="Close" IsCancel="True"
              Click="Close_Click" MinWidth="90" Margin="0,0,8,0"/>
      <Button x:Name="ApplyButton" Grid.Column="3" Content="Apply local change"
              Click="Apply_Click" IsEnabled="False" MinWidth="155"
              Style="{StaticResource PrimaryButton}"/>
    </Grid>
  </Grid>
</Window>

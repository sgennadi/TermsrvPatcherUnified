<Window x:Class="TermsrvPatcherUnified.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostics — 1.0.4" Width="960" Height="770"
        MinWidth="650" MinHeight="520" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource BackgroundBrush}" Icon="Assets/app.ico">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22">
      <TextBlock Text="Help improve compatibility" FontSize="23"
                 FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="Share basic Windows and program information. Nothing is sent automatically."
                 TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,15"/>
      <CheckBox x:Name="IncludeWindowsEvidenceCheck"
                Content="Include Windows build, termsrv.dll version and SHA-256"
                IsChecked="True" Margin="0,1,0,13"
                Checked="EvidenceSelectionChanged" Unchecked="EvidenceSelectionChanged"
                ToolTip="The file checksum can identify a custom Windows DLL build. Uncheck to omit it."/>

      <Border BorderThickness="1" BorderBrush="#CBD5E1" CornerRadius="9"
              Padding="14" Margin="0,0,0,12" Background="White">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" FontSize="17"
                     Text="Send compatibility report to GitHub"/>
          <TextBlock Text="No account or local save needed. The report becomes a PUBLIC GitHub Issue only after you approve it."
                     TextWrapping="Wrap" Foreground="#64748B" Margin="0,5,0,11"/>
          <WrapPanel>
            <Button x:Name="GoogleButton" Content="Send report"
                    Style="{StaticResource PrimaryButton}" Click="GoogleReport_Click"
                    IsEnabled="False" Margin="0,0,10,6" MinWidth="145"/>
            <Button x:Name="PreviewDirectButton" Content="Preview details"
                    Click="PreviewDirect_Click" IsEnabled="False" Margin="0,0,8,6"/>
          </WrapPanel>
          <Button x:Name="OpenConfirmedIssueButton" Content="View confirmed GitHub Issue"
                  Visibility="Collapsed" Click="OpenConfirmedIssue_Click"
                  HorizontalAlignment="Left" Margin="0,3,0,5"/>
          <TextBlock x:Name="GoogleStatus"
                     Text="Checking the reporting service configuration..."
                     TextWrapping="Wrap" Foreground="#64748B" Margin="0,5,0,0"/>
        </StackPanel>
      </Border>

      <GroupBox Header="Report preview (optional)" Margin="0,0,0,11">
        <TextBox x:Name="ReportPreview" FontFamily="Consolas" FontSize="12"
                 Height="165" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
      </GroupBox>
      <TextBlock x:Name="Status" Foreground="#64748B"
                 Text="Reports are optional. No local file or account is required."
                 TextWrapping="Wrap" Margin="0,0,0,8"/>

      <Expander Header="Advanced: local copy, GitHub and relay" Margin="0,7,0,10">
        <StackPanel Margin="4,9,4,2">
          <TextBlock x:Name="ErrorLabel" FontWeight="SemiBold"/>
          <TextBlock Text="Optional private note for a local copy or manual GitHub Issue. The direct Google report excludes it."
                     TextWrapping="Wrap" Foreground="#64748B" Margin="0,5,0,8"/>
          <TextBox x:Name="DescriptionInput" TextWrapping="Wrap" AcceptsReturn="True"
                   MinHeight="66" MaxHeight="105" VerticalScrollBarVisibility="Auto"
                   TextChanged="DescriptionChanged"/>
          <WrapPanel Margin="0,10,0,12">
            <Button x:Name="SaveButton" Content="Review and save locally"
                    Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            <Button Content="Copy report" Click="Copy_Click"/>
            <Button Content="Open GitHub" Click="OpenIssue_Click"/>
          </WrapPanel>
          <Border BorderThickness="1" BorderBrush="#CBD5E1" CornerRadius="9" Padding="13" Margin="0,0,0,11">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" FontSize="15" Text="GitHub — directly, no receiver or personal token"/>
          <TextBlock Text="No client ID entry needed. Sign in with GitHub in your browser, then publish an approved public Issue."
                     Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,9"/>
          <WrapPanel>
            <Button x:Name="GitHubSignInButton" Content="Connect GitHub"
                    Click="GitHubConnect_Click" IsEnabled="False" Margin="0,0,8,6"/>
            <Button x:Name="GitHubCancelButton" Content="Cancel sign-in" Click="GitHubCancel_Click"
                    IsEnabled="False" Margin="0,0,8,6"/>
          </WrapPanel>
          <TextBlock x:Name="GitHubDeviceStatus" Text="Direct GitHub sign-in is not configured in this build."
                     TextWrapping="Wrap" Foreground="#64748B" Margin="0,2,0,7"/>
          <WrapPanel>
            <TextBox x:Name="GitHubCodeInput" Width="118" IsReadOnly="True" Margin="0,0,7,6"
                     FontFamily="Consolas" ToolTip="Verification code shown when browser sign-in starts"/>
            <Button x:Name="CopyGitHubCodeButton" Content="Copy code" Click="CopyDeviceCode_Click"
                    IsEnabled="False" Margin="0,0,8,6"/>
            <Button x:Name="PublishButton" Content="Publish via GitHub" Tag="&#xE8B5;"
                    Style="{StaticResource PrimaryButton}" Click="Publish_Click"
                    IsEnabled="False" Margin="0,0,8,6"/>
          </WrapPanel>
          <Expander Header="Advanced: temporary GitHub Issues token" Margin="0,3,0,2">
            <StackPanel Margin="0,7,0,2">
              <TextBlock Text="Optional alternative to browser sign-in. Token is never saved."
                         Foreground="#64748B" TextWrapping="Wrap"/>
              <PasswordBox x:Name="SessionToken" Height="32" Padding="7"
                           ToolTip="Temporary PAT with Issues:write for this repository"/>
            </StackPanel>
          </Expander>
          <TextBlock Text="OAuth App requests public_repo access, which also grants broader public repository access. Review GitHub's permission prompt."
                     FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
          <Expander Header="Alternative: self-hosted diagnostics relay (optional)" Margin="0,0,0,12">
        <StackPanel Margin="4,8,0,3">
          <WrapPanel>
            <Button x:Name="AnonymousButton" Content="Send via relay" Style="{StaticResource PrimaryButton}"
                    Click="Anonymous_Click" IsEnabled="False"/>
            <TextBlock x:Name="RelayState" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="#64748B" Text="Not configured — local reports only" Margin="12,0,0,0"/>
          </WrapPanel>
          <TextBlock Text="Only available after your administrator deploys an HTTPS receiver. No receiver is included in the app."
                     TextWrapping="Wrap" Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>
      </Expander>
        </StackPanel>
      </Expander>
      <TextBlock FontSize="11" Foreground="#64748B" TextWrapping="Wrap"
                 Text="Google may observe your network IP address. Successfully delivered reports are PUBLIC GitHub Issues. You control when to send."/>
    </StackPanel>
  </ScrollViewer>
</Window>
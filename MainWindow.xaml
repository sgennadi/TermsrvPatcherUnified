<Window x:Class="TermsrvPatcherUnified.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TermsrvPatcherUnified 1.0.5-preview.2"
        Width="1290" Height="830" MinWidth="810" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13" Icon="Assets/app.ico">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,15">
      <DockPanel Margin="0,0,0,12">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="TermsrvPatcherUnified" FontSize="24" FontWeight="SemiBold"
                     Foreground="{StaticResource NavyBrush}"/>
          <TextBlock Text="1.0.5-preview.2  |  Windows x64" FontSize="12"
                     Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
          <TextBlock Text="Remote Desktop inspection, verified patterns and reversible changes"
                     Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
        </StackPanel>
      </DockPanel>
      <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
        <Button x:Name="SimpleModeButton" Tag="&#xE72B;" Content="Back to Simple" Click="SimpleMode_Click" MinWidth="155"/>
        <Button x:Name="CleanupButton" Tag="&#xE74D;" Content="Cleanup..." Click="Cleanup_Click" MinWidth="115"/>
        <Button x:Name="UpdatesButton" Tag="&#xE896;" Content="Updates" Click="Updates_Click" MinWidth="125"/>
        <Button Tag="&#xE9CE;" Content="Diagnostics" Click="Diagnostics_Click" MinWidth="140"/>
        <Button Tag="&#xE946;" Content="About / Components" Click="About_Click" MinWidth="175"/>
      </WrapPanel>
    </StackPanel>
    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Padding="16" CornerRadius="7" Margin="0,0,0,15">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="SystemText" FontWeight="SemiBold" FontSize="15" Text="Detecting operating system..."/>
          <TextBlock x:Name="DllText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock x:Name="StatusText" Margin="0,7,0,0" FontWeight="SemiBold" Foreground="#28589D"/>
          <CheckBox x:Name="CreateBackupCheck" IsChecked="True" Margin="0,9,0,0"
                    Content="Create backup before applying (recommended)"
                    ToolTip="Automatic Reapply always creates a full backup, regardless of this manual preference."/>
          <CheckBox x:Name="AdvancedAutoReapplyCheck" IsChecked="False"
                    Content="Auto reapply after Windows Update" Margin="0,9,0,0"
                    Checked="AutoReapplyChanged" Unchecked="AutoReapplyChanged"/>
          <TextBlock x:Name="AdvancedAutoReapplyStatus"
                     Text="Scheduled task: checking..." Margin="20,4,0,0"
                     Foreground="{StaticResource MutedBrush}" FontSize="12"/>
          <CheckBox x:Name="AdvancedAutoUpdateCheck"
                    Content="Auto-update Stable (confirm before installing)" Margin="0,10,0,0"
                    IsChecked="False" Checked="AutoUpdateChanged" Unchecked="AutoUpdateChanged"
                    ToolTip="Checks at startup and every 4 hours; existing trusted SYSTEM task may check when scheduled. Unsigned EXE installation always requires interactive approval."/>
          <TextBlock x:Name="AdvancedAutoUpdateStatus"
                     Text="Automatic Stable checks: not configured."
                     Margin="20,4,0,0" TextWrapping="Wrap"
                     Foreground="{StaticResource MutedBrush}" FontSize="12"/>
          <Button x:Name="AdvancedRevokeAutoReportsButton" Content="Stop automatic reports"
                  Visibility="Collapsed" Margin="20,7,0,0" MinWidth="210"
                  HorizontalAlignment="Left" Click="RevokeAutoReports_Click"/>
          <Button x:Name="AdvancedRepairTaskButton" Content="Repair task permissions..."
                  Visibility="Collapsed" Margin="20,7,0,0" MinWidth="210"
                  HorizontalAlignment="Left" Click="RepairAutoReapply_Click"/>
        </StackPanel>
        <Button x:Name="RefreshButton" Grid.Column="1" Tag="&#xE72C;" Content="Check DLL" Style="{StaticResource PrimaryButton}"
                Click="Refresh_Click" VerticalAlignment="Center" Margin="15,0,0,0"/>
      </Grid>
    </Border>
    <TabControl Grid.Row="2" x:Name="MainTabs" Padding="10,6" Background="White"
                SelectionChanged="MainTabs_SelectionChanged">
      <TabItem Header="Automatic">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="15,18,15,10">
            <TextBlock Text="Automatic Pattern Recognition" FontSize="19"
                       FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
            <Border Background="{StaticResource SoftBlueBrush}" CornerRadius="9"
                    Padding="17" Margin="0,12,0,15">
              <StackPanel>
                <TextBlock x:Name="AutoSimpleStatus" Text="Press Check DLL to inspect the current file."
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource NavyBrush}"/>
                <TextBlock x:Name="AutoSimpleProfile" Text="Detected pattern: not checked"
                           Margin="0,6,0,0" Foreground="{StaticResource ContentBrush}"/>
                <TextBlock x:Name="AutoSimpleReason" Text="No changes can be applied without a verified exact match."
                           Margin="0,5,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"/>
              </StackPanel>
            </Border>
            <Expander x:Name="AutoTechnicalDetails" Header="Technical details (read-only)"
                      IsExpanded="False" Margin="0,0,0,10">
              <StackPanel Margin="0,10,0,3">
                <GroupBox Header="Automatic Apply priority — exact signatures first, one target only"
                      Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="All candidates are checked before a target is chosen. Higher priority cannot override collisions, unsupported systems or multiple incompatible matches."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Margin="0,4,0,9"/>
                <TextBlock x:Name="AutoPrioritySummary" Text="Press Check DLL to see the ordered signature list."
                           TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"
                           Margin="0,0,0,8"/>
                <DataGrid x:Name="AutoPriorityGrid" Height="167" IsReadOnly="True"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" CanUserReorderColumns="False"
                          HeadersVisibility="Column" SelectionMode="Single"
                          SelectionChanged="AutoPrioritySelectionChanged"
                          GridLinesVisibility="Horizontal" RowHeight="32">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="38"/>
                    <DataGridTextColumn Header="Priority pattern" Binding="{Binding Name}" Width="230"/>
                    <DataGridTextColumn Header="Exact hits" Binding="{Binding Match}" Width="98"/>
                    <DataGridTextColumn Header="Offset" Binding="{Binding Offsets}" Width="134"/>
                    <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="112"/>
                    <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="340"/>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Select a row to view Find above Replace below. Selection only changes the read-only preview, never the Apply target. The 12-byte hotpatch reference is inspection-only."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Margin="0,8,0,2"/>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="Match and preview">
              <StackPanel>
                <TextBlock x:Name="AutoSummary" Text="Press Check DLL to inspect the installed file."/>
                <TextBox x:Name="AutoDetails" Height="145" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         Margin="0,12,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Exact signature evidence — read-only" FontWeight="SemiBold"
                           Margin="0,14,0,5"/>
                <TextBlock x:Name="AutoSignatureSummary" Text="Press Check DLL to inspect each exact catalog signature."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/>
                <TextBlock Text="Profile-level classification" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <DataGrid x:Name="AutoProfileGrid" IsReadOnly="True" CanUserAddRows="False"
                          AutoGenerateColumns="False" HeadersVisibility="Column" Height="132"
                          GridLinesVisibility="Horizontal">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Catalog profile" Binding="{Binding Profile}" Width="260"/>
                    <DataGridTextColumn Header="Classification" Binding="{Binding Classification}" Width="350"/>
                    <DataGridTextColumn Header="Offsets" Binding="{Binding Offsets}" Width="155"/>
                    <DataGridTextColumn Header="Fixed bytes" Binding="{Binding FixedBytes}" Width="95"/>
                    <DataGridTextColumn Header="Groups" Binding="{Binding Groups}" Width="65"/>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Exact Find / Replace groups" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <DataGrid x:Name="AutoSignatureGrid" IsReadOnly="True" CanUserAddRows="False"
                          AutoGenerateColumns="False" HeadersVisibility="Column"
                          Height="178" GridLinesVisibility="Horizontal"
                          SelectionMode="Single" SelectionChanged="AutoSignatureSelectionChanged">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="220"/>
                    <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="55"/>
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="205"/>
                    <DataGridTextColumn Header="Find" Binding="{Binding FindHits}" Width="65"/>
                    <DataGridTextColumn Header="Find offsets" Binding="{Binding FindOffsets}" Width="160"/>
                    <DataGridTextColumn Header="Replace" Binding="{Binding ReplaceHits}" Width="75"/>
                    <DataGridTextColumn Header="Replace offsets" Binding="{Binding ReplaceOffsets}" Width="160"/>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Selected signature — Find directly above Replace, aligned by byte" FontWeight="SemiBold"
                           Margin="0,12,0,5"/>
                <TextBox x:Name="AutoSelectedPair" IsReadOnly="True" Height="112" FontFamily="Consolas"
                         FontSize="12" Margin="0,0,0,7" TextWrapping="NoWrap"
                         Text="Select a signature group above to compare exact bytes and wildcard positions."
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                <TextBlock Text="Full signature evidence (read-only)" FontWeight="SemiBold"
                           Margin="0,3,0,5"/>
                <TextBox x:Name="AutoSignatureDetails" IsReadOnly="True" Height="130" FontFamily="Consolas"
                         FontSize="12" Margin="0,2,0,0" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                <WrapPanel Margin="0,9,0,0">
                  <Button x:Name="AutoInspectFindButton" Tag="&#xE8B5;"
                          Content="Inspect selected Find in HEX"
                          IsEnabled="False" Click="AutoInspectFind_Click"/>
                  <Button x:Name="AutoInspectReplaceButton" Tag="&#xE8B5;"
                          Content="Inspect selected Replace in HEX"
                          IsEnabled="False" Click="AutoInspectReplace_Click"/>
                  <Button x:Name="AutoEvidenceExportButton" Tag="&#xE74E;"
                          Content="Export signature evidence..." IsEnabled="False"
                          Click="AutoEvidenceExport_Click"/>
                </WrapPanel>
                <TextBlock Text="Select a matching group above to view its bytes in Manual. This does not populate replacement bytes or enable Apply."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,0,7"/>
                <TextBlock Text="Duplicate/overlapping signatures remain blocked, even if the Windows version looks compatible."
                           Foreground="#8B531A" TextWrapping="Wrap" Margin="0,7,0,0"/>
              </StackPanel>
            </GroupBox>
                <WrapPanel Margin="0,3,0,0">
                  <Button Tag="&#xE74E;" Content="Export DryRun JSON..."
                          Click="ExportAutoDryRun_Click"/>
                  <Button Tag="&#xE8B7;" Content="Open backups folder"
                          Click="OpenBackups_Click"/>
                </WrapPanel>
              </StackPanel>
            </Expander>
            <WrapPanel Margin="0,4,0,0">
              <Button x:Name="ApplyAutoButton" Tag="&#xE8FB;" Content="Apply verified patch" IsEnabled="False"
                      Style="{StaticResource PrimaryButton}" Click="ApplyAuto_Click"/>
              <Button x:Name="RestoreButton" Tag="&#xE7A7;" Content="Restore backup..." Click="Restore_Click"/>
            </WrapPanel>
            <TextBlock Text="WARNING: Applying or restoring a patch temporarily stops Remote Desktop services and can disconnect your RDP session. Test locally before deployment."
                       Foreground="#8B531A" Margin="0,12,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Manual">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="15,18,15,10">
            <TextBlock Text="Manual pattern (fallback only)" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Provide exact find/replace sequences. '*' matches one unknown byte in Find; '|' separates related groups. No unknown bytes are filled in automatically."
                       Margin="0,7,0,17" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="Find HEX pattern" FontWeight="SemiBold"/>
            <TextBox x:Name="ManualFind" TextChanged="ManualEdited" MinHeight="64" MaxHeight="110" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,5,0,8"/>
            <GroupBox Header="Find fragment in installed DLL — read-only" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Name="ManualFragmentSummary" Text="Type at least two complete bytes, e.g. 44 8B or 448B. Matches appear as you type."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,6"/>
                <DataGrid x:Name="ManualFragmentGrid" IsReadOnly="True" CanUserAddRows="False"
                          AutoGenerateColumns="False" Height="150" HeadersVisibility="Column"
                          SelectionChanged="ManualFragmentSelectionChanged">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="65"/>
                    <DataGridTextColumn Header="Offset" Binding="{Binding Address}" Width="110"/>
                    <DataGridTextColumn Header="Actual bytes" Binding="{Binding ActualHex}" Width="225"/>
                    <DataGridTextColumn Header="Context (before [matched] after)" Binding="{Binding Context}" Width="520"/>
                  </DataGrid.Columns>
                </DataGrid>
                <GroupBox Header="HEX Viewer — actual DLL bytes" Margin="0,12,0,7">
                  <GroupBox.Resources>
                    <Style x:Key="ManualHexCellStyle" TargetType="{x:Type TextBlock}">
                      <Setter Property="Foreground" Value="{StaticResource ContentBrush}"/>
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="FontFamily" Value="Consolas"/>
                      <Setter Property="FontSize" Value="12"/>
                      <Setter Property="TextAlignment" Value="Center"/>
                      <Setter Property="VerticalAlignment" Value="Center"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFixedMatch}" Value="True">
                          <Setter Property="Background" Value="#CBAAF6"/>
                          <Setter Property="Foreground" Value="#31135A"/>
                          <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsWildcardMatch}" Value="True">
                          <Setter Property="Background" Value="#B4EBEF"/>
                          <Setter Property="Foreground" Value="#064F62"/>
                          <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </GroupBox.Resources>
                  <StackPanel>
                    <TextBlock x:Name="ManualHexHeader"
                               Text="Select a match above to inspect actual DLL bytes at that address."
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ManualHexMask"
                               Text="Find mask: (not selected)"
                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource NavyBrush}" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,5">
                      <Button x:Name="ManualHexPrevious" Content="Previous match"
                              Click="ManualHexPrevious_Click" IsEnabled="False"/>
                      <Button x:Name="ManualHexNext" Content="Next match"
                              Click="ManualHexNext_Click" IsEnabled="False"/>
                      <Button x:Name="ManualHexCopy" Content="Copy actual HEX"
                              Click="ManualHexCopy_Click" IsEnabled="False"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                      <Border Background="#CBAAF6" Width="17" Height="13" Margin="0,0,5,0"/>
                      <TextBlock Text="Exact matched bytes" Margin="0,0,16,0"
                                 Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                      <Border Background="#B4EBEF" Width="17" Height="13" Margin="0,0,5,0"/>
                      <TextBlock Text="Wildcard (actual byte)" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </WrapPanel>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="5" Background="#F8FBFF">
                      <ScrollViewer Height="320" VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto" CanContentScroll="True">
                        <StackPanel Margin="8,7,8,7" HorizontalAlignment="Left">
                          <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="91"/>
                              <ColumnDefinition Width="480"/>
                              <ColumnDefinition Width="22"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ADDRESS" FontFamily="Consolas"
                                       FontSize="12" FontWeight="Bold"/>
                            <ItemsControl x:Name="ManualHexColumnHeaders" Grid.Column="1">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding}" Width="30" FontFamily="Consolas"
                                             FontSize="12" FontWeight="Bold"
                                             TextAlignment="Center"/>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Column="2" Text="|" FontFamily="Consolas"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="DUMP / ASCII" FontFamily="Consolas"
                                       FontWeight="Bold"/>
                          </Grid>
                          <ItemsControl x:Name="ManualHexRows">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="0,0,0,2" Height="19">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="91"/>
                                    <ColumnDefinition Width="480"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="Auto"/>
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0" Text="{Binding Address}"
                                             FontFamily="Consolas" FontSize="12"
                                             Foreground="{StaticResource MutedBrush}"
                                             VerticalAlignment="Center"/>
                                  <ItemsControl Grid.Column="1" ItemsSource="{Binding Bytes}">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <TextBlock Text="{Binding Hex}" Width="30"
                                                   Style="{StaticResource ManualHexCellStyle}"/>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <TextBlock Grid.Column="2" Text="|" FontFamily="Consolas"
                                             FontSize="12" VerticalAlignment="Center"
                                             HorizontalAlignment="Center"/>
                                  <ItemsControl Grid.Column="3" ItemsSource="{Binding Bytes}">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <TextBlock Text="{Binding Ascii}" Width="12"
                                                   Style="{StaticResource ManualHexCellStyle}"/>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </ScrollViewer>
                    </Border>
                    <TextBlock Text="The HEX viewer is read-only. It never guesses replacement bytes or enables Apply."
                               Foreground="#8B531A" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0"/>
                  </StackPanel>
                </GroupBox>
                <TextBlock Text="Live lookup does not generate Replace bytes or authorize Apply."
                           Foreground="#8B531A" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </GroupBox>
            <TextBlock Text="Replace HEX pattern (same byte count)" FontWeight="SemiBold"/>
            <TextBox x:Name="ManualReplace" TextChanged="ManualEdited" MinHeight="64" MaxHeight="110" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,5,0,7"/>
            <TextBlock x:Name="ManualInputStatus" Text="Enter Find and Replace bytes to check equal lengths."
                       TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"
                       Margin="0,0,0,11"/>
            <WrapPanel>
              <Button Tag="&#xE721;" Content="Check manual pattern" Click="CheckManual_Click"/>
              <Button Tag="&#xE74E;" Content="Save pattern..." Click="SaveManual_Click"/>
              <Button Tag="&#xE74E;" Content="Export DryRun JSON..." Click="ExportManualDryRun_Click"/>
              <Button x:Name="ApplyManualButton" Tag="&#xE8FB;" Content="Apply manual patch" Style="{StaticResource PrimaryButton}"
                      IsEnabled="False" Click="ApplyManual_Click"/>
            </WrapPanel>
            <TextBlock x:Name="ManualResult" Text="Manual mode is inactive until you check a pattern." Margin="0,4,0,15"/>
            <GroupBox Header="Import old Patches.txt for manual selection">
              <StackPanel>
                <WrapPanel>
                  <Button Tag="&#xE8B5;" Content="Import patterns..." Click="Import_Click"/>
                  <Button Tag="&#xE73E;" Content="Check selected" Click="CheckImported_Click"/>
                  <Button x:Name="CheckAllImportedButton" Tag="&#xE721;" Content="Check all imported"
                          Click="CheckAllImported_Click"/>
                </WrapPanel>
                <ComboBox x:Name="ImportSelector" SelectionChanged="ImportedSelectionChanged" DisplayMemberPath="Label" MinHeight="32"/>
                <TextBlock x:Name="ImportedInfo" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock x:Name="ImportedCatalogSummary" Text="Import a pattern catalog to compare all entries."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,7"/>
                <DataGrid x:Name="ImportedResultsGrid" IsReadOnly="True" CanUserAddRows="False"
                          AutoGenerateColumns="False" Height="190" HeadersVisibility="Column"
                          SelectionChanged="ImportedResultSelectionChanged">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="42"/>
                    <DataGridTextColumn Header="Pattern / version" Binding="{Binding Label}" Width="255"/>
                    <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="225"/>
                    <DataGridTextColumn Header="OS/release" Binding="{Binding WindowsHint}" Width="225"/>
                    <DataGridTextColumn Header="DLL version" Binding="{Binding DllVersionHint}" Width="225"/>
                    <DataGridTextColumn Header="Offsets" Binding="{Binding Offsets}" Width="135"/>
                    <DataGridTextColumn Header="Assessment" Binding="{Binding Verdict}" Width="330"/>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBox x:Name="ImportedCheckDetails" IsReadOnly="True" Height="130"
                         FontFamily="Consolas" FontSize="12" Margin="0,8,0,0"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Search DLL">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="15,18,15,10">
            <TextBlock Text="Read-only scan of termsrv.dll" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Select a DLL and search for known structural markers or a custom HEX sequence. Candidate offsets are hints—not safe patch instructions."
                       Foreground="{StaticResource MutedBrush}" Margin="0,7,0,15"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="SearchFile" TextChanged="ScanInputChanged" Grid.Column="0" VerticalContentAlignment="Center" MinHeight="36" Margin="0,0,10,10"/>
              <Button Grid.Column="1" Tag="&#xE8B7;" Content="Browse DLL..." Click="BrowseDll_Click"/>
            </Grid>
            <TextBlock Text="Optional custom Find HEX (* wildcard)" FontWeight="SemiBold"/>
            <TextBox x:Name="SearchPattern" TextChanged="ScanInputChanged" FontFamily="Consolas" MinHeight="36" Margin="0,5,0,12"/>
            <WrapPanel>
              <Button Tag="&#xE721;" Content="Search inside DLL" Style="{StaticResource PrimaryButton}" Click="Search_Click"/>
              <Button Tag="&#xEDE1;" Content="Export report..." Click="ExportScan_Click"/>
              <Button Tag="&#xE8C8;" Content="Copy report" Click="CopyScan_Click"/>
            </WrapPanel>
            <TextBox x:Name="ScanDetails" Height="255" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Offline DLL">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="15,18,15,14">
            <TextBlock Text="Patch a selected termsrv.dll copy" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Choose a file from any folder. No NSudo, service restart, or system DLL replacement. The original is never overwritten."
                       Foreground="{StaticResource MutedBrush}" Margin="0,7,0,16" TextWrapping="Wrap"/>
            <TextBlock Text="Source DLL" FontWeight="SemiBold"/>
            <Grid Margin="0,5,0,13">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="OfflineSource" Grid.Column="0" IsReadOnly="True" MinHeight="36"
                       VerticalContentAlignment="Center" Margin="0,0,10,0"/>
              <Button Grid.Column="1" Tag="&#xE8B7;" Content="Browse termsrv.dll..." Click="OfflineBrowse_Click"/>
            </Grid>
            <TextBlock Text="Automatic signatures are checked for the DLL's own x86/x64 architecture. If no signature matches, enter a known manual pair below; unknown bytes are not guessed."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
            <TextBlock Text="Optional manual Find HEX (* wildcard, | separates groups)" FontWeight="SemiBold"/>
            <TextBox x:Name="OfflineFind" TextChanged="OfflineInputsChanged" MinHeight="46" MaxHeight="85"
                     AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,5,0,12"/>
            <TextBlock Text="Optional manual Replace HEX (same number of bytes)" FontWeight="SemiBold"/>
            <TextBox x:Name="OfflineReplace" TextChanged="OfflineInputsChanged" MinHeight="46" MaxHeight="85"
                     AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,5,0,13"/>
            <WrapPanel Margin="0,0,0,12">
              <Button x:Name="OfflineInspectButton" Tag="&#xE721;" Content="Check selected DLL"
                      Style="{StaticResource PrimaryButton}" Click="OfflineInspect_Click"/>
              <Button x:Name="OfflineSaveButton" Tag="&#xE74E;" Content="Save patched copy..."
                      IsEnabled="False" Click="OfflineSave_Click"/>
              <Button Tag="&#xE8C8;" Content="Copy report" Click="OfflineCopy_Click"/>
              <Button Tag="&#xEDE1;" Content="Export report..." Click="OfflineExport_Click"/>
            </WrapPanel>
            <TextBox x:Name="OfflineDetails" Height="220" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"
                     Text="Choose termsrv.dll to see architecture, version, original CRC32/SHA-256 and detected changes."/>
            <TextBlock Text="After saving a new DLL copy, review the report before optionally sending its CRC32, SHA-256, file version, architecture and modified byte ranges to GitHub. Nothing uploads automatically."
                       TextWrapping="Wrap" Foreground="#8B531A" Margin="0,12,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Remote Desktop">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12,11,12,12">
            <TextBlock Text="Remote Desktop" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource NavyBrush}"/>
            <TextBlock Text="Configuration, policy sources and local controls at a glance."
                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"/>
            <Border Background="{StaticResource SoftBlueBrush}" CornerRadius="10"
                    Padding="13" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock x:Name="RdpOverviewText" FontSize="14" FontWeight="SemiBold"
                           Text="Reading local RDP configuration..." Foreground="{StaticResource NavyBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <UniformGrid Columns="4">
                  <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,7,0">
                    <StackPanel>
                      <TextBlock Text="Remote Desktop" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock x:Name="RdpEffectiveEnabledText" Text="Unknown" FontSize="16"
                                 FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,7,0">
                    <StackPanel>
                      <TextBlock Text="NLA" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock x:Name="RdpEffectiveNlaText" Text="Unknown" FontSize="16"
                                 FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,7,0">
                    <StackPanel>
                      <TextBlock Text="Single session" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock x:Name="RdpEffectiveSingleText" Text="Unknown" FontSize="16"
                                 FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Background="White" CornerRadius="8" Padding="10">
                    <StackPanel>
                      <TextBlock Text="Blank passwords" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock x:Name="RdpEffectiveBlankText" Text="Unknown" FontSize="16"
                                 FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,3"/>
                      <Button x:Name="OpenBlankPasswordSettingButton" Content="Configure..."
                              Click="OpenBlankPasswordSetting_Click"
                              HorizontalAlignment="Left" MinWidth="92" Padding="8,3"
                              ToolTip="Open the blank-password restriction row and its local editor"/>
                    </StackPanel>
                  </Border>
                </UniformGrid>
                <TextBlock x:Name="RdpServiceText" Text="TermService: not inspected."
                           Margin="0,9,0,2" TextWrapping="Wrap" FontSize="12"/>
                <WrapPanel Margin="0,1,0,0">
                  <TextBlock x:Name="RdpEffectivePortText" Text="Port: not inspected"
                             Foreground="{StaticResource ContentBrush}" Margin="0,0,17,2" FontSize="12"/>
                  <TextBlock x:Name="RdpEffectiveFirewallText" Text="Firewall: not verified"
                             Foreground="{StaticResource ContentBrush}" Margin="0,0,17,2" FontSize="12"/>
                  <TextBlock x:Name="RdpEffectiveRestartText" Text="Restart: not determined"
                             Foreground="{StaticResource ContentBrush}" FontSize="12"/>
                </WrapPanel>
                <TextBlock x:Name="RdpPolicyOverviewText" Text="Policy: not inspected"
                           Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" FontSize="12"/>
                <TextBlock Text="Values below show configuration evidence, not guaranteed remote reachability. GPO refresh and firewall effectiveness are not inferred."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" Margin="0,4,0,0"/>
                <WrapPanel Margin="0,12,0,0">
                  <Button x:Name="RunRdpDoctorButton" Content="Run RDP Doctor"
                          Tag="&#xE721;" Style="{StaticResource PrimaryButton}"
                          Click="RunRdpDoctor_Click" MinWidth="160"/>
                  <TextBlock x:Name="RdpDoctorQuickStatus"
                             Text="Doctor: not inspected. Local diagnosis only."
                             FontSize="12" Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap" VerticalAlignment="Center"
                             Margin="10,3,0,3"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Expander x:Name="RdpDoctorPanel" Header="RDP Doctor — connection diagnostics"
                      IsExpanded="False" Margin="0,0,0,10">
              <StackPanel Margin="0,10,0,4">
                <TextBlock Text="Find local Remote Desktop problems, examine recent Windows events and review safer next steps. No changes are made."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Margin="0,5,0,10"/>
                <Border Background="{StaticResource SoftBlueBrush}" CornerRadius="11"
                        Padding="14" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock x:Name="DoctorVerdictText" Text="Not inspected. Press Run diagnostic to collect local RDP evidence."
                               FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,9"/>
                    <UniformGrid Columns="3" Margin="0,0,0,9">
                      <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,7,0">
                        <StackPanel>
                          <TextBlock Text="Local blockers" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                          <TextBlock x:Name="DoctorBlockersText" Text="--" FontSize="20"
                                     FontWeight="SemiBold" Foreground="#9F321D"/>
                        </StackPanel>
                      </Border>
                      <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,7,0">
                        <StackPanel>
                          <TextBlock Text="Needs attention" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                          <TextBlock x:Name="DoctorAttentionText" Text="--" FontSize="20"
                                     FontWeight="SemiBold" Foreground="#95520A"/>
                        </StackPanel>
                      </Border>
                      <Border Background="White" CornerRadius="8" Padding="10">
                        <StackPanel>
                          <TextBlock Text="Unverified" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                          <TextBlock x:Name="DoctorUnknownText" Text="--" FontSize="20"
                                     FontWeight="SemiBold" Foreground="#475569"/>
                        </StackPanel>
                      </Border>
                    </UniformGrid>
                    <WrapPanel>
                      <Button x:Name="CopyRdpDoctorButton" Content="Copy safe report"
                              Tag="&#xE8C8;" Click="CopyRdpDoctor_Click"
                              IsEnabled="False" MinWidth="145"/>
                    </WrapPanel>
                    <TextBlock x:Name="DoctorCheckedText" Text="No scan has been run."
                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="This is a local inspection, NOT a remote connectivity, licensing, or authentication test. Red status is evidence of a possible local blocker, not permission to weaken Windows security."
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
                <GroupBox Header="Checks, evidence and recommended next steps" Margin="0,0,0,10">
                  <StackPanel>
                    <DataGrid x:Name="DoctorFindingsGrid" IsReadOnly="True"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Height="365" MinHeight="220"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                      <DataGrid.Resources>
                        <Style x:Key="DoctorWrapText" TargetType="TextBlock">
                          <Setter Property="TextWrapping" Value="Wrap"/>
                          <Setter Property="VerticalAlignment" Value="Center"/>
                          <Setter Property="Margin" Value="4,4,4,4"/>
                        </Style>
                      </DataGrid.Resources>
                      <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                          <Setter Property="MinHeight" Value="36"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Blocker">
                              <Setter Property="Background" Value="#FEF2F2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Attention">
                              <Setter Property="Background" Value="#FFF7ED"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </DataGrid.RowStyle>
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Check" Binding="{Binding Area}" Width="1.4*"
                                            MinWidth="170" ElementStyle="{StaticResource DoctorWrapText}"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.9*"
                                            MinWidth="110" ElementStyle="{StaticResource DoctorWrapText}"/>
                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2.5*"
                                            MinWidth="270" ElementStyle="{StaticResource DoctorWrapText}"/>
                        <DataGridTextColumn Header="Recommended next step" Binding="{Binding Recommendation}"
                                            Width="2.6*" MinWidth="280"
                                            ElementStyle="{StaticResource DoctorWrapText}"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </GroupBox>
                <Expander x:Name="RdpExtendedDiagnostics"
                          Header="Technical evidence — Firewall, logon rights, TLS and graphics"
                          IsExpanded="False" Margin="0,0,0,9">
                  <StackPanel Margin="0,9,0,7">
                    <TextBlock x:Name="RdpInspectionStatus"
                               Text="Run RDP Doctor to collect technical details using the same scan."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <UniformGrid Columns="2">
                      <GroupBox Header="Firewall - inbound Remote Desktop rules" Margin="0,0,5,6">
                        <TextBox x:Name="RdpFirewallInspection" Height="194" FontSize="12"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Text="Not inspected. Rule presence does not guarantee connectivity."/>
                      </GroupBox>
                      <GroupBox Header="Allow / Deny remote interactive logon" Margin="5,0,0,6">
                        <TextBox x:Name="RdpRightsInspection" Height="194" FontSize="12"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Text="Not inspected. LSA user-right assignments require local Windows access."/>
                      </GroupBox>
                      <GroupBox Header="RDP TLS listener certificate" Margin="0,6,5,0">
                        <TextBox x:Name="RdpCertificateInspection" Height="194" FontSize="12"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Text="Not inspected. Binding, validity dates and local certificate store only."/>
                      </GroupBox>
                      <GroupBox Header="RDP graphics - GPU, H.264/AVC, WDDM" Margin="5,6,0,0">
                        <TextBox x:Name="RdpGraphicsInspection" Height="194" FontSize="12"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Text="Not inspected. Computer GPO preferences only; no codec negotiation probe."/>
                      </GroupBox>
                    </UniformGrid>
                    <TextBlock Text="Read-only local inspection. Account names and certificate details remain in this window and are not added to anonymous diagnostics. GPO state, firewall reachability and successful authentication cannot be inferred."
                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,7,0,0"/>
                  </StackPanel>
                </Expander>
                <GroupBox Header="Windows RDP events — last 24 hours">
                  <StackPanel>
                    <TextBlock Text="Latest event metadata only: UTC time, provider/channel, event ID and severity. Account names, IP addresses and event messages are NOT collected."
                               TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                    <DataGrid x:Name="DoctorEventsGrid" IsReadOnly="True" Height="210"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="UTC" Binding="{Binding DateUtc}" Width="160"/>
                        <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="*"/>
                        <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="93"/>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Level}" Width="110"/>
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="DoctorEventStatus" Text="Event channels not inspected."
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                    <TextBlock Text="A missing event or successful local TCP listen never proves that an RDP client can connect. Test separately from an authorized remote computer."
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                  </StackPanel>
                </GroupBox>
              </StackPanel>
            </Expander>

            <GroupBox Header="Connection and security" Margin="0,0,0,10">
              <StackPanel>
                <Grid Margin="0,1,0,7">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="220"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <CheckBox Grid.Row="0" x:Name="RdpEnabled" Content="Enable Remote Desktop" Margin="0,4,10,6"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RdpEnabledSourceText" Text="Policy: checking..."
                             TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"
                             Margin="0,5,0,5"/>
                  <CheckBox Grid.Row="1" x:Name="NlaEnabled" Content="Require Network Level Authentication (recommended)"
                            Margin="0,4,10,6"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="NlaSourceText" Text="Policy: checking..."
                             TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"
                             Margin="0,5,0,5"/>
                  <CheckBox Grid.Row="2" x:Name="SingleSession" Content="Limit to one session per user"
                            Margin="0,4,10,6"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SingleSourceText" Text="Policy: checking..."
                             TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"
                             Margin="0,5,0,5"/>
                  <CheckBox Grid.Row="3" x:Name="FirewallEnabled" Content="Synchronize Domain / Private inbound firewall rules"
                            IsChecked="True" Margin="0,4,10,6"
                            ToolTip="Request synchronized firewall rules during Save; this checkbox is not an assessment of current firewall reachability."/>
                  <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FirewallSourceText"
                             Text="Apply option; actual rules not checked" TextWrapping="Wrap"
                             FontSize="11" Foreground="{StaticResource MutedBrush}"
                             Margin="0,5,0,5"/>
                </Grid>
                <TextBlock x:Name="RdpDetails" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,7"/>
                <WrapPanel>
                  <Button Content="Apply selected" Tag="&#xE74E;" Style="{StaticResource PrimaryButton}"
                          Click="SaveSettings_Click" MinWidth="140"/>
                  <Button Content="Reload" Tag="&#xE72C;" Click="ReadSettings_Click" MinWidth="96"/>
                  <Button x:Name="RefreshComputerPolicyButton" Content="Refresh Computer Policy"
                          Tag="&#xE72C;" Click="RefreshComputerPolicy_Click" MinWidth="183"/>
                  <Button x:Name="ReviewRdpRestartButton" Content="Review service restart"
                          Tag="&#xE7F4;" Click="ReviewRdpRestart_Click"
                          MinWidth="178" IsEnabled="False"/>
                </WrapPanel>
              </StackPanel>
            </GroupBox>

            <Expander Header="After applying - connection and restart guidance" IsExpanded="False"
                      Margin="0,0,0,9">
              <Border Background="{StaticResource SoftBlueBrush}" CornerRadius="8"
                      Padding="10" Margin="0,6,0,0">
                <StackPanel>
                  <TextBlock x:Name="RdpApplyImpactText" TextWrapping="Wrap"
                             Foreground="{StaticResource ContentBrush}"
                             Text="Local changes do not automatically run gpupdate, reboot or restart TermService. Test a new RDP connection."/>
                  <TextBlock x:Name="RdpPostApplyActions" TextWrapping="Wrap"
                             Foreground="{StaticResource NavyBrush}" Margin="0,5,0,0"
                             Text="No pending action established."/>
                </StackPanel>
              </Border>
            </Expander>

            <Expander x:Name="RdpTechnicalAdvanced" Header="Advanced - policy sources, listener and sessions"
                      IsExpanded="False">
              <StackPanel Margin="0,8,0,0">
                <GroupBox Header="Registry, Group Policy and local RSoP source">
                  <StackPanel>
                    <WrapPanel>
                      <Button Content="Check configuration" Tag="&#xE721;"
                              Click="CheckRdpPolicy_Click" MinWidth="170"/>
                      <TextBlock x:Name="RdpPolicySummary" Text="Configuration has not been inspected."
                                 TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                 VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <TextBlock Text="Light green: local editing available. Amber: controlled by GPO. Gray: inspection only or additional rights required. Double-click an editable row or select Edit."
                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,7,0,2"/>
                    <DataGrid x:Name="RdpPolicyGrid" IsReadOnly="True" CanUserAddRows="False"
                              AutoGenerateColumns="False" Height="385" MinHeight="260"
                              HorizontalAlignment="Stretch" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" SelectionMode="Single"
                              SelectionChanged="RdpPolicySelectionChanged"
                              MouseDoubleClick="RdpPolicyGrid_MouseDoubleClick"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Margin="0,8,0,0">
                      <DataGrid.Resources>
                        <Style x:Key="RdpGridWrapText" TargetType="TextBlock">
                          <Setter Property="TextWrapping" Value="Wrap"/>
                          <Setter Property="VerticalAlignment" Value="Center"/>
                          <Setter Property="Margin" Value="4,4,4,4"/>
                        </Style>
                      </DataGrid.Resources>
                      <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                          <Setter Property="MinHeight" Value="34"/>
                          <Setter Property="ToolTip" Value="{Binding EditStatus}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding CanEdit}" Value="True">
                              <Setter Property="Background" Value="#F0FAF4"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PolicyLocked}" Value="True">
                              <Setter Property="Background" Value="#FFF7ED"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </DataGrid.RowStyle>
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Setting" Binding="{Binding Setting}"
                                            Width="1.8*" MinWidth="180"
                                            ElementStyle="{StaticResource RdpGridWrapText}"/>
                        <DataGridTextColumn Header="Local value" Binding="{Binding LocalValue}"
                                            Width="1.8*" MinWidth="175"
                                            ElementStyle="{StaticResource RdpGridWrapText}"/>
                        <DataGridTextColumn Header="Group Policy" Binding="{Binding PolicyValue}"
                                            Width="1.55*" MinWidth="160"
                                            ElementStyle="{StaticResource RdpGridWrapText}"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding Assessment}"
                                            Width="1.35*" MinWidth="135"
                                            ElementStyle="{StaticResource RdpGridWrapText}"/>
                        <DataGridTextColumn Header="Editing" Binding="{Binding EditStatus}"
                                            Width="1.5*" MinWidth="150"
                                            ElementStyle="{StaticResource RdpGridWrapText}"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Explanation}"
                                            Width="2.3*" MinWidth="270"
                                            ElementStyle="{StaticResource RdpGridWrapText}"/>
                        <DataGridTemplateColumn Header="Action" Width="100" MinWidth="94">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Button Content="Edit..." Tag="{Binding}" IsEnabled="{Binding CanEdit}"
                                      ToolTip="{Binding EditStatus}"
                                      Click="EditRdpPolicyRow_Click" MinWidth="77"
                                      Margin="2,1,2,1" Padding="6,3"/>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="BlankPasswordInlineEditor" Visibility="Collapsed"
                            Background="#F0F6FF" BorderBrush="#BDD4F1"
                            BorderThickness="1" CornerRadius="8" Padding="12"
                            Margin="0,9,0,8">
                      <StackPanel>
                        <TextBlock Text="Blank passwords — Windows local security policy"
                                   FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,5"/>
                        <TextBlock x:Name="BlankPasswordStatus" Text="Security policy not checked."
                                   TextWrapping="Wrap" Margin="0,2,0,7"/>
                        <TextBlock Text="Choose the local setting. This does not guarantee RDP sign-in or override a domain security GPO."
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="BlankPasswordChoice" Height="34" MinWidth="300"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,7"
                                  ToolTip="HKLM\SYSTEM\CurrentControlSet\Control\Lsa\LimitBlankPasswordUse">
                          <ComboBoxItem Content="Restrict blank-password accounts to console (recommended)"/>
                          <ComboBoxItem Content="Allow by local security policy (high risk)"/>
                        </ComboBox>
                        <WrapPanel>
                          <Button x:Name="SaveBlankPasswordButton"
                                  Content="Save this local security setting"
                                  Click="SaveBlankPassword_Click" Tag="&#xE74E;"
                                  HorizontalAlignment="Left" MinWidth="205"/>
                          <TextBlock Text="Administrator required; changes are verified and may be overwritten by Group Policy."
                                     Foreground="#8B531A" FontSize="12"
                                     VerticalAlignment="Center" TextWrapping="Wrap"
                                     Margin="9,2,0,2"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <Border Background="#F0F6FF" BorderBrush="#BDD4F1" BorderThickness="1"
                            CornerRadius="8" Padding="10" Margin="0,8,0,7">
                      <StackPanel>
                        <TextBlock x:Name="RdpPolicySelectedOwner" TextWrapping="Wrap"
                                   Foreground="#334155" FontSize="12"
                                   Text="Choose a setting to inspect its source and local edit permissions."/>
                        <WrapPanel Margin="0,7,0,0">
                          <TextBlock Text="Editable? Use the row's Edit button or double-click it."
                                     VerticalAlignment="Center" TextWrapping="Wrap"
                                     Foreground="{StaticResource MutedBrush}"
                                     Margin="0,2,9,2"/>
                          <Button Content="Copy policy source" Click="CopySelectedPolicy_Click"
                                  MinWidth="152"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <Expander Header="Raw read-only RDP policy evidence" IsExpanded="False">
                      <TextBox x:Name="RdpPolicyDetails" IsReadOnly="True" Height="118"
                               FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"
                               VerticalScrollBarVisibility="Auto"
                               Text="Read-only registry and RSoP evidence."/>
                    </Expander>
                    <TextBlock Text="A policy registry value may be pending Group Policy refresh. A winning GPO is identified only where RSoP evidence is available."
                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,7,0,0"/>
                  </StackPanel>
                </GroupBox>
                <GroupBox Header="Local RDP sessions - Windows WTS API" Margin="0,8,0,0">
                  <StackPanel>
                    <WrapPanel>
                      <Button Content="Refresh sessions" Tag="&#xE72C;"
                              Click="RefreshRdpSessions_Click" MinWidth="160"/>
                      <TextBlock x:Name="RdpSessionsCountText" Text="Sessions: not checked"
                                 VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <TextBlock x:Name="RdpSessionSummary" Text="Session inventory has not been read."
                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,6"/>
                    <DataGrid x:Name="RdpSessionsGrid" IsReadOnly="True" CanUserAddRows="False"
                              AutoGenerateColumns="False" SelectionMode="Single" Height="176"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding SessionId}" Width="50"/>
                        <DataGridTextColumn Header="Station" Binding="{Binding Station}" Width="*"/>
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="108"/>
                        <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="*"/>
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Read-only. Session account names stay local and are not included in anonymous diagnostics."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               FontSize="11" Margin="0,6,0,0"/>
                  </StackPanel>
                </GroupBox>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="System Health">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12,11,12,12">
            <TextBlock Text="System and DLL health" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource NavyBrush}"/>
            <TextBlock Text="Read-only integrity monitoring, separate from Remote Desktop configuration."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Margin="0,5,0,11"/>
            <GroupBox Header="DLL integrity - version and SHA-256">
              <StackPanel>
                <WrapPanel>
                  <Button Content="Check DLL health" Tag="&#xE721;"
                          Style="{StaticResource PrimaryButton}" Click="CheckDllHealth_Click"/>
                  <Button Content="Save current as baseline..."
                          Tag="&#xE74E;" Click="SaveDllBaseline_Click"/>
                </WrapPanel>
                <TextBlock x:Name="DllHealthStatusText"
                           Text="First check can record the initial observation (unverified)."
                           Foreground="#91400B" FontWeight="SemiBold" TextWrapping="Wrap"
                           Margin="0,7,0,2"/>
                <TextBox x:Name="DllHealthDetails" IsReadOnly="True" Height="226"
                         FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Margin="0,9,0,7"
                         Text="No baseline comparison yet. Check DLL health to review local evidence."/>
                <TextBlock Text="First seen is saved automatically once in the local profile and is NEVER claimed to be an original Microsoft DLL. An operator-saved baseline is separate. Neither observation grants permission to modify or restore the DLL."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="DLL compatibility evidence — read only">
              <StackPanel>
                <TextBlock Text="Exact DLL version/SHA-256 matches from bundled metadata. Anonymous diagnostic reports and self-reported fixes are NOT independent verification."
                           TextWrapping="Wrap" Margin="0,0,0,9"
                           Foreground="{StaticResource MutedBrush}"/>
                <WrapPanel Margin="0,0,0,8">
                  <Button x:Name="RefreshCompatibilityButton" Content="Check compatibility evidence"
                          Click="CheckDllCompatibility_Click" MinWidth="210"
                          Tag="&#xE721;"/>
                  <Button x:Name="CopyCompatibilityButton" Content="Copy evidence"
                          Click="CopyDllCompatibility_Click" MinWidth="135"
                          IsEnabled="False" Tag="&#xE8C8;"/>
                </WrapPanel>
                <TextBlock x:Name="DllCompatibilitySummary"
                           Text="Not inspected. This evidence never authorizes DLL changes."
                           TextWrapping="Wrap" FontWeight="SemiBold"
                           Foreground="#91400B" Margin="0,0,0,8"/>
                <DataGrid x:Name="DllCompatibilityGrid" IsReadOnly="True"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Height="300" MinHeight="190"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="1.2*" MinWidth="145"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.1*" MinWidth="135"/>
                    <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2.8*" MinWidth="250"/>
                    <DataGridTextColumn Header="Next step" Binding="{Binding NextStep}" Width="2.6*" MinWidth="240"/>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="First Seen is not an original Microsoft file. Public reports are unverified, and neither SHA matches nor user reports affect Apply, Revert, licensing or network reachability."
                           TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                           Foreground="{StaticResource MutedBrush}"/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="History">
        <Grid Margin="15,18,15,14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Local operation history" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Margin="0,7,0,12" TextWrapping="Wrap"
                     Foreground="{StaticResource MutedBrush}"
                     Text="User-local metadata only: no accounts, hostnames, paths or raw exception messages. History never authorizes Apply/Restore."/>
          <Button Grid.Row="2" Tag="&#xE72C;" Content="Refresh history" Click="RefreshOperationHistory_Click"
                  Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,9"/>
          <DataGrid x:Name="OperationHistoryGrid" Grid.Row="3" IsReadOnly="True"
                    CanUserAddRows="False" AutoGenerateColumns="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="UTC" Binding="{Binding AtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="165"/>
              <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="105"/>
              <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90"/>
              <DataGridTextColumn Header="DLL version" Binding="{Binding DllVersion}" Width="130"/>
              <DataGridTextColumn Header="Application" Binding="{Binding AppVersion}" Width="125"/>
              <DataGridTextColumn Header="Failure type" Binding="{Binding FailureType}" Width="135"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="4" x:Name="OperationHistorySummary" Text="Press Refresh history to load local records."
                     TextWrapping="Wrap" Margin="0,9,0,0" Foreground="{StaticResource MutedBrush}"/>
        </Grid>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="3" Margin="0,15,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="FooterText" Text="GPLv3 | Automatic matching by file content | No patch without a unique match"
                 Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Tag="&#xE8A7;" Content="Open operation log" Click="Log_Click" Margin="10,0,0,0"/>
    </Grid>
  </Grid>
</Window>

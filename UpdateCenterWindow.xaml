<Window x:Class="TermsrvPatcherUnified.UpdateCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updates — 0.1.0-preview.16" Width="760" Height="620" MinWidth="620" MinHeight="535"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource BackgroundBrush}" Icon="Assets/app.ico">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,17">
      <TextBlock Text="Application updates" FontSize="23" FontWeight="SemiBold"/>
    </DockPanel>
    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="TermsrvPatcherUnified" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock x:Name="InstalledText" Foreground="#64748B" Margin="0,5,0,10"/>
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="Release channel" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,12,0"/>
          <ComboBox x:Name="ChannelSelector" Width="160" MinHeight="35" HorizontalAlignment="Left"
                    SelectionChanged="ChannelChanged">
            <ComboBoxItem Content="Stable"/>
            <ComboBoxItem Content="Preview"/>
          </ComboBox>
        </DockPanel>
        <TextBlock x:Name="StatusText" Margin="0,11,0,0" FontWeight="SemiBold"
                   Text="No update check yet."/>
        <TextBlock x:Name="SourceText" Margin="0,4,0,0" Foreground="#64748B"/>
      </StackPanel>
    </Border>
    <GroupBox Grid.Row="2" Header="What's new" Margin="0,0,0,12">
      <TextBox x:Name="NotesText" Text="Release notes appear after a successful live check."
               VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" IsReadOnly="True"
               FontFamily="Segoe UI" FontSize="13" BorderThickness="0"/>
    </GroupBox>
    <Grid Grid.Row="3">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Grid.Row="0" x:Name="InstallHelp" Foreground="#8B531A"
                 TextWrapping="Wrap" Margin="0,0,0,10"
                 Text="Check for a LIVE release first. Installation requires an elevated EXE in a protected Program Files folder."/>
      <WrapPanel Grid.Row="1">
        <Button x:Name="CheckButton" Tag="&#xE72C;" Content="Check" Style="{StaticResource PrimaryButton}"
                Click="Check_Click" MinWidth="105"/>
        <Button x:Name="InstallButton" Tag="&#xE896;" Content="Install" Click="Install_Click" MinWidth="105" IsEnabled="False"/>
        <Button x:Name="ReleasePageButton" Tag="&#xE774;" Content="Open GitHub release"
                Click="OpenRelease_Click" MinWidth="155"/>
        <Button Tag="&#xE8BB;" Content="Close" Click="Close_Click" MinWidth="105"/>
      </WrapPanel>
    </Grid>
  </Grid>
</Window>

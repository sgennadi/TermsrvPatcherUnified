<Window x:Class="TermsrvPatcherUnified.UpdateCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updates — 1.0.5-preview.1" Width="920" Height="680" MinWidth="690" MinHeight="535"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource BackgroundBrush}" Icon="Assets/app.ico">
  <Window.Resources>
    <Style x:Key="ChannelPillStyle" TargetType="RadioButton">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Pill" CornerRadius="9" Background="Transparent"
                    Padding="{TemplateBinding Padding}" BorderThickness="1"
                    BorderBrush="Transparent" MinWidth="128">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="White"/>
                <Setter TargetName="Pill" Property="BorderBrush" Value="#B8D1F3"/>
                <Setter Property="Foreground" Value="#1355A3"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Pill" Property="Opacity" Value="0.8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Pill" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,17">
      <TextBlock Text="Application updates" FontSize="23" FontWeight="SemiBold"/>
    </DockPanel>
    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="TermsrvPatcherUnified" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock x:Name="InstalledText" Foreground="#64748B" Margin="0,5,0,10"/>
        <StackPanel>
          <TextBlock Text="Choose release channel" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12"
                  Background="#EDF3FB" Padding="4" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="StableChannelButton" Content="Stable"
                           GroupName="UpdateReleaseChannel" Style="{StaticResource ChannelPillStyle}"
                           Checked="ChannelChanged" ToolTip="Production release channel"/>
              <RadioButton x:Name="PreviewChannelButton" Content="Preview"
                           GroupName="UpdateReleaseChannel" Style="{StaticResource ChannelPillStyle}"
                           Checked="ChannelChanged" ToolTip="Early access builds"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="ChannelHint" Text="Preview — early builds and testing"
                     Foreground="#64748B" TextWrapping="Wrap" Margin="0,7,0,0"
                     FontSize="12"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Margin="0,11,0,0" FontWeight="SemiBold"
                   Text="No update check yet."/>
        <TextBlock x:Name="SourceText" Margin="0,4,0,0" Foreground="#64748B"/>
      </StackPanel>
    </Border>
    <GroupBox Grid.Row="2" Header="What's new" Margin="0,0,0,12">
      <TextBox x:Name="NotesText" Text="Release notes appear after a successful live check."
               VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" IsReadOnly="True"
               FontFamily="Segoe UI" FontSize="13" BorderThickness="0"/>
    </GroupBox>
    <Grid Grid.Row="3">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Grid.Row="0" x:Name="InstallHelp" Foreground="#8B531A"
                 TextWrapping="Wrap" Margin="0,0,0,10"
                 Text="Check for a LIVE release first. You can update the EXE from any regular local folder, including Desktop and Downloads."/>
      <WrapPanel Grid.Row="1">
        <Button x:Name="CheckButton" Tag="&#xE72C;" Content="Check" Style="{StaticResource PrimaryButton}"
                Click="Check_Click" MinWidth="105"/>
        <Button x:Name="InstallButton" Tag="&#xE896;" Content="Install" Click="Install_Click" MinWidth="105" IsEnabled="False"/>
        <Button x:Name="ReleasePageButton" Tag="&#xE774;" Content="Open GitHub release"
                Click="OpenRelease_Click" MinWidth="155"/>
        <Button Tag="&#xE8BB;" Content="Close" Click="Close_Click" MinWidth="105"/>
      </WrapPanel>
    </Grid>
  </Grid>
</Window>
